{
  "name": "dsh-mermaid",
  "version": "0.1.0-rc.1",
  "description": "DeepSeek Harness (DSH) web plugin that renders mermaid code fences in chat messages as diagrams",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakehemmerle/dsh-mermaid.git"
  },
  "homepage": "https://github.com/jakehemmerle/dsh-mermaid#readme",
  "keywords": [
    "dsh-plugin",
    "mermaid"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.mermaid.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:e2e": "vitest run --project browser --project web --project tui",
    "prepare": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "mermaid": "^12.1.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
